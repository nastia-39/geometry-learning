en, N. and Vannerom, D. and van Santen, J. and Vara, J. and {Veitch-Michaelis}, J. and Verpoest, S. and Veske, D. and Walck, C. and Wang, W. and Watson, T. B. and Weaver, C. and Weigel, P. and Weindl, A. and Weldert, J. and Wendt, C. and Werthebach, J. and Weyrauch, M. and Whitehorn, N. and Wiebusch, C. H. and Willey, N. and Williams, D. R. and Wolf, M. and Wrede, G. and Wulff, J. and Xu, X. W. and Yanez, J. P. and Yildizci, E. and Yoshida, S. and Yu, S. and Yuan, T. and Zhang, Z. and Zhelnin, P.},
  year = 2022,
  month = nov,
  journal = {Journal of Instrumentation},
