@misc{zhouTransformersLearnVariableorder2024,
  title = {Transformers Learn Variable-Order {{Markov}} Chains in-Context},
  author = {Zhou, Ruida and Tian, Chao and Diggavi, Suhas},
  year = 2024,
  month = oct,
  number = {arXiv:2410.05493},
