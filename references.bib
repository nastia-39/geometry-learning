  shorttitle = {Spectral {{Inference Networks}}},
  author = {Pfau, David and Petersen, Stig and Agarwal, Ashish and Barrett, David G. T. and Stachenfeld, Kimberly L.},
  year = 2020,
  month = jan,
  number = {arXiv:1806.02215},
