@misc{songBridgingDimensionalChasm2025,
  title = {Bridging the {{Dimensional Chasm}}: {{Uncover Layer-wise Dimensional Reduction}} in {{Transformers}} through {{Token Correlation}}},
  shorttitle = {Bridging the {{Dimensional Chasm}}},
