  author = {Choma, Nicholas and Monti, Federico and Gerhardt, Lisa and Palczewski, Tomasz and Ronaghi, Zahra and Prabhat and Bhimji, Wahid and Bronstein, Michael M. and Klein, Spencer R. and Bruna, Joan},
  year = 2018,
