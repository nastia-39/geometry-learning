@article{innanQuantumStateTomography2024,
  title = {Quantum {{State Tomography}} Using {{Quantum Machine Learning}}},
  author = {Innan, Nouhaila and Siddiqui, Owais Ishtiaq and Arora, Shivang and Ghosh, Tamojit and Ko{\c c}ak, Yasemin Poyraz and Paragas, Dominic and Galib, Abdullah Al Omar and Khan, Muhammad Al-Zafar and Bennai, Mohamed},
