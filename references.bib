@misc{bruel-gabrielssonRewiringPositionalEncodings2023,
  title = {Rewiring with {{Positional Encodings}} for {{Graph Neural Networks}}},
  author = {{Br{\"u}el-Gabrielsson}, Rickard and Yurochkin, Mikhail and Solomon, Justin},
  year = 2023,
  month = dec,
  number = {arXiv:2201.12674},
